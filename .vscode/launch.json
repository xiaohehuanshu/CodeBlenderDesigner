{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LangGraph Agent: Single Run (Recommended)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/langgraph_agent/run_agent.py",
      "cwd": "${workspaceFolder}/langgraph_agent",
      "console": "integratedTerminal",
      "args": [
        "--request-file",
        "${workspaceFolder}/langgraph_agent/request_case_001.json"
      ]
    },
    {
      "name": "LangGraph Agent: Interactive (Recommended)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/langgraph_agent/run_agent.py",
      "cwd": "${workspaceFolder}/langgraph_agent",
      "console": "integratedTerminal",
      "args": [
        "--request-file",
        "${workspaceFolder}/langgraph_agent/request_case_001.json",
        "--interactive"
      ]
    }
  ]
}
