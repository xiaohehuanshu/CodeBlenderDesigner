# Qwen / DashScope
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus
ENABLE_QWEN_WEB_SEARCH=true

# OpenAI-compatible codegen
OPENAI_API_KEY=
OPENAI_BASE_URL=https://haoshunxin.cloud/v1
OPENAI_MODEL=gpt-5.4

# Blender
BLENDER_EXECUTABLE=

# Output / runtime
DEFAULT_OUTPUT_DIR=outputs
VALIDATE_GENERATED_SCRIPT=true
SCRIPT_VALIDATION_TIMEOUT_SECONDS=120
AUTO_EXECUTE_GENERATED_SCRIPT=false
EXPORT_GLB=true
ENABLE_NEW_GENERATION_FULL_SCRIPT_QUICK_PATH=false

# Web API
PALX_API_HOST=0.0.0.0
PALX_API_PORT=8000
PALX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
